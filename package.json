{
  "name": "hvac-logic",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://hvaclogic.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/miadsaadidi/hvaclogic.git"
  },
  "bugs": {
    "url": "https://github.com/miadsaadidi/hvaclogic/issues"
  },
  "author": "Miad S.",
  "license": "MIT",
  "keywords": [
    "hvac",
    "building-science",
    "thermodynamics",
    "psychrometrics",
    "duct-sizing",
    "manual-j",
    "manual-d",
    "heat-pump",
    "refrigeration",
    "engineering-calculators"
  ],
  "scripts": {
    "predev": "node scripts/generate-service-worker.mjs",
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "prebuild": "node scripts/generate-service-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:offline": "playwright test --config=playwright.offline.config.ts",
    "indexnow": "node scripts/ping-indexnow.mjs"
  },
  "dependencies": {
    "next": "15.1.12",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "eslint": "9.20.1",
    "eslint-config-next": "15.1.12",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
